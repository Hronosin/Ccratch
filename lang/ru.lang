# Ccratch: русский. Шаблон для новых языков: ccratch --lang-template
@name   = Русский
@plural = slavic

# окно
topbar.build = Собрать
palette.title = Блоки
palette.drop = отпусти — и нет его
palette.code_line = строка кода
empty.title = Перетащи сюда .c файл
empty.hint = (или: ccratch file.c)

# статус: что сейчас произошло
status.no_file = Файла нет. Перетащи .c файл в окно.
status.cannot_read = Не получилось прочитать %s. Опять работать...
status.oom_layout = Кончилась память, пока раскладывались блоки.
status.loaded_clean = %s: без происшествий. Ящик для пожертвований: всё ещё пуст.
status.loaded_errors = %s: %u ошибка (подробности в терминале). Опять работать...|%s: %u ошибки (подробности в терминале). Опять работать...|%s: %u ошибок (подробности в терминале). Опять работать...
status.not_saved = Не сохранено: %s
status.no_backup = Не сохранено: не удалось записать копию %s~
status.cannot_write = Не сохранено: не удалось записать %s
status.saved = Сохранено: %s (оригинал в %s~).
status.saved_errors = Сохранено: %s, но теперь clang видит %u ошибку (подробности в терминале).|Сохранено: %s, но теперь clang видит %u ошибки (подробности в терминале).|Сохранено: %s, но теперь clang видит %u ошибок (подробности в терминале).
status.left_out = %u свободный стек не попал в файл.|%u свободных стека не попали в файл.|%u свободных стеков не попали в файл.
status.language = Язык: %s

# статус справа: подсказки
bar.loose = %u свободный стек (не компилируется)|%u свободных стека (не компилируются)|%u свободных стеков (не компилируются)
bar.zoom = масштаб %d%%
bar.hints = ПКМ: меню  |  ПКМ тянуть: двигать  колесо: масштаб  |  Ctrl+S сохранить  Z отменить  Y вернуть  |  Home  F5

# пай-меню
pie.save = Сохранить
pie.comment = Закомментировать
pie.uncomment = Раскомментировать
pie.redo = Вернуть
pie.edit_text = Изменить текст
pie.delete = Удалить
pie.fit_view = В начало
pie.undo = Отменить
pie.duplicate = Дублировать
pie.key.click_field = клик по полю
pie.key.delete = Del

# сохранение не удалось
save.unsafe_gap = строка %u: между инструкциями этого блока есть #if/#define или код из макроса, поэтому безопасно переписать его пока нельзя
save.lost = строка %u: изменённый код оказался там, где его не найти в файле
save.empty_slot = строка %u: пустое место; впиши туда что-нибудь или брось блок
